<group name="syscheck,homelab,">
  <rule id="100100" level="12">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">(?i)^c:\\securitylab\\important\.txt$</field>
    <field name="changed_fields" type="pcre2">\bsha256\b</field>
    <description>HomeLab: Important Windows file modified.</description>
  </rule>
</group>

<group name="homelab,sysmon,">
  <rule id="100101" level="5">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <description>HomeLab: whoami.exe executed.</description>
  </rule>
</group>

<group name="homelab_powershell,">
  <rule id="100102" level="7">
    <if_sid>92027</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)SOC-LAB-POWERSHELL-ARCHIVE-TEST</field>
    <description>HomeLab: PowerShell SOC lab test command executed.</description>
  </rule>
</group>

<group name="homelab_network,">
  <rule id="100103" level="7">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^5156$</field>
    <field name="win.eventdata.sourceAddress">^192\.168\.139\.129$</field>
    <description>HomeLab: Network connection detected from Kali Linux.</description>
  </rule>
</group>

<group name="homelab_network_scan,">
  <rule id="100104" level="10" frequency="10" timeframe="10">
    <if_matched_sid>100103</if_matched_sid>
    <same_field>win.eventdata.sourceAddress</same_field>
    <description>HomeLab: Possible network scan detected from Kali Linux.</description>
  </rule>
</group>

<group name="homelab_authentication,">
  <rule id="100105" level="12" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>HomeLab: Possible brute-force authentication attack detected.</description>
  </rule>
</group>

<group name="homelab_account_management,">
  <rule id="100106" level="10">
    <if_sid>60109</if_sid>
    <field name="win.system.eventID">^4720$</field>
    <description>HomeLab: New Windows user account created.</description>
  </rule>
</group>

<group name="homelab_privilege_escalation,">
  <rule id="100107" level="12">
    <if_sid>60154</if_sid>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^Administrators$</field>
    <description>HomeLab: User added to local Administrators group - possible privilege escalation.</description>
  </rule>
</group>

<group name="homelab_malware,">
  <rule id="100108" level="14">
    <if_sid>62123</if_sid>
    <description>HomeLab: Microsoft Defender detected malware or potentially unwanted software.</description>
  </rule>
</group>

<group name="homelab_powershell_encoded,">
  <rule id="100109" level="14">
    <if_sid>92057</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-EncodedCommand</field>
    <description>HomeLab: Encoded PowerShell command detected - possible obfuscated execution.</description>
  </rule>
</group>

<group name="homelab_persistence,">
  <rule id="100110" level="12">
    <if_sid>60228</if_sid>
    <description>HomeLab: Scheduled task created - possible persistence activity.</description>
  </rule>
</group>
